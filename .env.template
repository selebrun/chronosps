# ============================================================
# CHRONOS PS — Variables de entorno
# ============================================================
# Copia este archivo como .env.local y completa los valores.
# NUNCA commitees el archivo .env.local con valores reales.
# ============================================================

# --- NextAuth ---
# URL pública de la app (sin barra final)
NEXTAUTH_URL=http://localhost:3000

# Secreto para firmar tokens JWT. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=REEMPLAZAR_CON_SECRET_GENERADO

# --- Base de datos PostgreSQL ---
CHRONOS_DB_USER=REEMPLAZAR_CON_USUARIO_DB
CHRONOS_DB_HOST=REEMPLAZAR_CON_HOST_DB
CHRONOS_DB_NAME=REEMPLAZAR_CON_NOMBRE_DB
CHRONOS_DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_DB
CHRONOS_DB_PORT=5432

# --- Admin interno Chronos ---
# Credenciales del panel /admin (acceso exclusivo del equipo Chronos)
CHRONOS_ADMIN_USER=REEMPLAZAR_CON_EMAIL_ADMIN
CHRONOS_ADMIN_PASSWORD=REEMPLAZAR_CON_PASSWORD_ADMIN
